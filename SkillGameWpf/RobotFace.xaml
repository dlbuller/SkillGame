<UserControl x:Class="SkillGameWpf.RobotFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox>
        <Canvas Width="180" Height="168" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="RootRot"/>
                    <TranslateTransform x:Name="RootTrans"/>
                </TransformGroup>
            </Canvas.RenderTransform>
            <!-- antenna -->
            <Line X1="90" Y1="30" X2="90" Y2="12" Stroke="#4A5568" StrokeThickness="4"/>
            <Ellipse Canvas.Left="82" Canvas.Top="2" Width="16" Height="16" Fill="{DynamicResource GoldBrush}">
                <Ellipse.Effect><DropShadowEffect x:Name="AntGlow" Color="#E7A91D" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/></Ellipse.Effect>
            </Ellipse>
            <!-- head -->
            <Border x:Name="HeadBorder" Canvas.Left="18" Canvas.Top="30" Width="144" Height="124" CornerRadius="28" Background="#1A1E28" BorderBrush="#31394A" BorderThickness="2">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.5"/></Border.Effect>
            </Border>
            <!-- ears -->
            <Border Canvas.Left="8"  Canvas.Top="72" Width="12" Height="34" CornerRadius="6" Background="#31394A"/>
            <Border Canvas.Left="160" Canvas.Top="72" Width="12" Height="34" CornerRadius="6" Background="#31394A"/>
            <!-- eyes (blink via ScaleY, look via shared translate) -->
            <Canvas>
                <Canvas.RenderTransform><TranslateTransform x:Name="LookT"/></Canvas.RenderTransform>
                <Border x:Name="LeftEye" Canvas.Left="46" Canvas.Top="66" Width="34" Height="44" CornerRadius="15" Background="#33C9FF" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="LeftEyeScale" ScaleY="1"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#33C9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                </Border>
                <Border x:Name="RightEye" Canvas.Left="100" Canvas.Top="66" Width="34" Height="44" CornerRadius="15" Background="#33C9FF" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="RightEyeScale" ScaleY="1"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect Color="#33C9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                </Border>
            </Canvas>
            <!-- mouth -->
            <Path x:Name="Mouth" Stroke="#8AA0B4" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 66,130 Q 90,140 114,130"/>

            <!-- "sick" X-eyes: shown only when the boards go missing (see SetMood "sick") -->
            <Canvas x:Name="SickX" Visibility="Collapsed">
                <Line X1="50" Y1="74" X2="76" Y2="102" Stroke="#E2493C" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="76" Y1="74" X2="50" Y2="102" Stroke="#E2493C" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="104" Y1="74" X2="130" Y2="102" Stroke="#E2493C" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="130" Y1="74" X2="104" Y2="102" Stroke="#E2493C" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
