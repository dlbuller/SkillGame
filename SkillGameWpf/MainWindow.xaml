<Window x:Class="SkillGameWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkillGame" Height="864" Width="1536"
        WindowStyle="None" WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown">

  <Grid>
    <!-- One Viewbox scales the whole design canvas to any window/screen size (crisp vector text). -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1536" Height="864" Background="{StaticResource AppBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0" Background="#0A0A0F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="24,30,20,26">
                        <TextBlock Text="SKILLGAME" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="28" Foreground="{DynamicResource GoldBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="SideLogoGlow" Color="#E7A91D" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="control panel" Foreground="{StaticResource MutedBrush}" FontSize="12.5" Margin="2,0,0,0"/>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,22,0,0"/>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top">
                        <!-- One highlight that slides between the selected items. -->
                        <Border x:Name="NavHighlight" VerticalAlignment="Top" Height="52" Margin="12,3" CornerRadius="10"
                                Background="#24242F" IsHitTestVisible="False">
                            <Border.RenderTransform><TranslateTransform x:Name="NavHi" Y="0"/></Border.RenderTransform>
                            <Border Width="4" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource GoldBrush}" Margin="0,12">
                                <Border.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                            </Border>
                        </Border>
                        <StackPanel>
                            <RadioButton x:Name="NavGame"  Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked"
                                         ToolTip="The live playfield — score, level and high scores. Drop a coin to play or run a demo game.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,13,0">
                                        <Border CornerRadius="5" BorderBrush="#E7A91D" BorderThickness="2"/>
                                        <Path Fill="#E7A91D" Data="M8.5,6 L16,11 L8.5,16 Z"/>
                                    </Grid>
                                    <TextBlock Text="Game Status" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDiag"  Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"
                                         ToolTip="Live switch &amp; lamp monitor, stuck-switch detection, self-test, and the mechanic gremlin.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,13,0">
                                        <Polyline Points="2,11 6,11 8,4 12,18 14,11 20,11" Stroke="#35C9FF" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <!-- Live health badge: green check when all good, pulsing red ! on a fault. -->
                                        <Border x:Name="DiagBadge" Width="16" Height="16" CornerRadius="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0"
                                                Background="#2FE08C" BorderBrush="#0A0A0F" BorderThickness="1.5" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="DiagBadgeGlow" Color="#2FE08C" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                            </Border.Effect>
                                            <TextBlock x:Name="DiagBadgeText" Text="&#x2713;" Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSet"   Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"
                                         ToolTip="Operator setup — game tuning, sound set, attract shows, accent colour, brightness, bench mode.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,13,0">
                                        <Path Fill="#C4C4D2" Data="M19.14,12.94a7.49,7.49,0,0,0,.05-.94,7.49,7.49,0,0,0-.05-.94l2-1.58a.5.5,0,0,0,.12-.61l-1.92-3.32a.5.5,0,0,0-.61-.22l-2.39.96a7,7,0,0,0-1.62-.94l-.36-2.54a.5.5,0,0,0-.5-.42H9.64a.5.5,0,0,0-.5.42l-.36,2.54a7,7,0,0,0-1.62.94l-2.39-.96a.5.5,0,0,0-.61.22L1.83,8.87a.5.5,0,0,0,.12.61l2,1.58a7.49,7.49,0,0,0,0,1.88l-2,1.58a.5.5,0,0,0-.12.61l1.92,3.32a.5.5,0,0,0,.61.22l2.39-.96a7,7,0,0,0,1.62.94l.36,2.54a.5.5,0,0,0,.5.42h3.84a.5.5,0,0,0,.5-.42l.36-2.54a7,7,0,0,0,1.62-.94l2.39.96a.5.5,0,0,0,.61-.22l1.92-3.32a.5.5,0,0,0-.12-.61ZM12,15.6A3.6,3.6,0,1,1,15.6,12,3.6,3.6,0,0,1,12,15.6Z"/>
                                    </Grid>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAudit" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"
                                         ToolTip="The machine's permanent books — games played, play time, power-on hours, winners, and switch wear.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="22" Height="22" Margin="0,0,13,0">
                                        <Rectangle Width="4" Height="8"  Fill="#16C8B0" HorizontalAlignment="Left"   VerticalAlignment="Bottom" Margin="3,0,0,3"/>
                                        <Rectangle Width="4" Height="13" Fill="#16C8B0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        <Rectangle Width="4" Height="18" Fill="#16C8B0" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                                    </Grid>
                                    <TextBlock Text="Audits" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSchem" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"
                                         ToolTip="Interactive wiring diagram — live block status, current flow, and click any block for its theory + pinout.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Canvas Width="22" Height="22" Margin="0,0,13,0">
                                        <!-- IC chip: body with pins down each side -->
                                        <Rectangle Canvas.Left="1"  Canvas.Top="6"  Width="4" Height="2" Fill="#B45AE0"/>
                                        <Rectangle Canvas.Left="1"  Canvas.Top="10" Width="4" Height="2" Fill="#B45AE0"/>
                                        <Rectangle Canvas.Left="1"  Canvas.Top="14" Width="4" Height="2" Fill="#B45AE0"/>
                                        <Rectangle Canvas.Left="17" Canvas.Top="6"  Width="4" Height="2" Fill="#B45AE0"/>
                                        <Rectangle Canvas.Left="17" Canvas.Top="10" Width="4" Height="2" Fill="#B45AE0"/>
                                        <Rectangle Canvas.Left="17" Canvas.Top="14" Width="4" Height="2" Fill="#B45AE0"/>
                                        <Border Canvas.Left="5" Canvas.Top="3" Width="12" Height="16" CornerRadius="2" Background="#1A1524" BorderBrush="#B45AE0" BorderThickness="2"/>
                                        <Ellipse Canvas.Left="7.5" Canvas.Top="5.5" Width="3" Height="3" Fill="#B45AE0"/>
                                    </Canvas>
                                    <TextBlock Text="Schematic" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavService" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked"
                                         ToolTip="One flat page: the key controls plus live diagnostics, self-test, lamp test, and replay the tutorial.">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Viewbox Width="22" Height="22" Margin="0,0,13,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                                                  Stroke="#E6A23C" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Service" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,20,18">
                        <!-- Maker panel -->
                        <Border CornerRadius="12" Margin="0,0,0,14" Padding="11,10" BorderThickness="1"
                                BorderBrush="#3AE7A91D">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#221A1405" Offset="0"/>
                                    <GradientStop Color="#14000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="50" Height="50" CornerRadius="25" VerticalAlignment="Center" Background="#F2EFE6" BorderBrush="#C9A227" BorderThickness="1.5">
                                    <Image Source="file:///C:/SkillGame/wheezingbull.png" Width="42" Height="42"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                    <TextBlock Text="WHEEZING BULL" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                               FontSize="13" Foreground="{DynamicResource GoldBrush}"/>
                                    <TextBlock Text="MADE BY" FontSize="8.5" Foreground="#6A6A76" Margin="0,4,0,1"/>
                                    <TextBlock Text="Scott Wezeman" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Dan Bullerman" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="MINIMIZE" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Height="42" Margin="0,0,0,8" Click="Min_Click"/>
                        <Button Content="EXIT" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Height="42" Margin="0,0,0,14" Click="Exit_Click" ToolTip="Close SkillGame"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HwDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HwText" Text="no hardware" Foreground="#5A5A66" FontSize="11.5" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Foreground="#4A4A56" FontSize="11" Margin="0,4,0,0" Text="v1.0   ·   F11 fullscreen"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <ContentControl x:Name="MainContent"/>

                <!-- Subtle CRT scanlines over the content (retro-arcade feel; clicks pass through). -->
                <Rectangle IsHitTestVisible="False" Opacity="0.6">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#22000000">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,3,1"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Grid>
    </Viewbox>
    <!-- Screen dimmer for the cabinet (over everything, clicks pass through). -->
    <Rectangle x:Name="DimOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False"/>

    <!-- First-run guided tour (replayable from the Service page). -->
    <Grid x:Name="TutorialOverlay" Visibility="Collapsed">
      <Rectangle Fill="#99000000"/>
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64" Width="560"
              CornerRadius="16" Background="#12141C" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1.5" Padding="26,22,26,20">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="TutStepText" Text="STEP 1 OF 8" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
          <TextBlock x:Name="TutTitle" Text="" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"
                     Foreground="{DynamicResource GoldBrush}"/>
          <TextBlock x:Name="TutBody" Text="" Foreground="{StaticResource TextBrush}" FontSize="15" TextWrapping="Wrap"
                     LineHeight="22" LineStackingStrategy="BlockLineHeight" Margin="0,10,0,18"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Skip tour" Style="{StaticResource PillButton}" Height="48" MinWidth="130" Padding="26,0" Click="Tut_Skip"/>
            <Button Grid.Column="2" x:Name="TutBackBtn" Content="Back" Style="{StaticResource PillButton}" Height="48" Width="100" Click="Tut_Back"/>
            <Button Grid.Column="4" x:Name="TutNextBtn" Content="Next" Style="{StaticResource GoldButton}" Height="48" Width="130" Click="Tut_Next"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
