<Window x:Class="SkillGameWpf.WiringTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wiring Test" Height="560" Width="1140"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="{StaticResource UiFont}">
    <Border Style="{StaticResource Card}" CornerRadius="14" Margin="10">
        <DockPanel Margin="10">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GUIDED WIRING TEST" Style="{StaticResource Caption}" Foreground="{StaticResource GreenBrush}"/>
                    <TextBlock Text="press each switch on the playfield — its tile turns green when it's wired" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="CLOSE" Style="{StaticResource DangerButton}" Width="110" Click="Close_Click"/>
            </Grid>

            <Border DockPanel.Dock="Top" CornerRadius="12" Background="#18000000" BorderBrush="#2216C8B0" BorderThickness="1" Padding="18,16" Margin="0,4,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PRESS" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="PromptText" Text="Switch 0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="34" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressText" Text="0 / 28 wired" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource CyanBrush}" TextAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="SKIP" Style="{StaticResource PillButton}" Width="90" Click="Skip_Click"/>
                            <Button Content="RESTART" Style="{StaticResource PillButton}" Width="110" Margin="8,0,0,0" Click="Restart_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- all 28 switches at once — no scrolling during diagnostics -->
            <UniformGrid x:Name="ChipHost" Columns="7"/>
        </DockPanel>
    </Border>
</Window>
