<UserControl x:Class="SkillGameWpf.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkillGameWpf"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <Style x:Key="GroupCap" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#C4C4D2"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,26,30,24" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="_enter" Y="20"/></Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="_enter" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="DIAGNOSTICS" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="34" Foreground="{DynamicResource GoldBrush}">
                    <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                </TextBlock>
                <StackPanel x:Name="PillHost" Orientation="Horizontal" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SelfTestBtn" Content="RUN SELF-TEST" Style="{StaticResource GoldButton}" Width="190" Height="52" Click="SelfTest_Click"
                        ToolTip="Power-on self-test: probe all four FT232H boards and report what responds."/>
                <Button x:Name="AllOffBtn" Content="ALL OFF" Style="{StaticResource PillButton}" Width="120" Height="52" Margin="12,0,0,0" Click="AllOff_Click"
                        ToolTip="Stop any running pattern and clear the lamp map."/>
            </StackPanel>
        </Grid>

        <!-- ===== Warning banner ===== -->
        <Border Grid.Row="1" x:Name="WarnBanner" CornerRadius="10" Margin="0,0,0,12" Padding="16,11"
                Background="#241E1405" BorderBrush="#66E7A91D" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="16" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E9CE86" FontSize="13"
                           Text="No FT232H boards detected — hardware tests are disabled. On-screen lamp previews still work."/>
            </StackPanel>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.75*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- Switch monitor -->
            <Border Grid.Column="0" x:Name="PanelSwitch" Style="{StaticResource Card}" Margin="0,0,7,0"
                    ToolTip="Every playfield switch. A tile lights when its switch closes — the live input map.">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SWITCH MONITOR" Style="{StaticResource Caption}" Foreground="{StaticResource GreenBrush}" Margin="0,0,0,10"/>
                    <!-- Live event log — the most recent switch / solenoid / special-lamp events -->
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" CornerRadius="10" Background="#18000000" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="10,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="EVENT LOG" Style="{StaticResource Caption}" FontSize="13" Foreground="{StaticResource PurpleBrush}" Margin="0,0,0,6"/>
                            <StackPanel x:Name="EventHost" Height="122"/>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="SwitchHost"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Live lamp map + gauge -->
            <Border Grid.Column="1" x:Name="PanelLamp" Style="{StaticResource Card}" Margin="7,0,7,0"
                    ToolTip="The backglass score lamps in their real layout — hundreds reels on top, tens across the bottom. Run a pattern to see them play.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LIVE LAMP MAP" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}"/>
                        <Button Grid.Column="1" x:Name="IdentifyBtn" Content="IDENTIFY" Style="{StaticResource PillButton}" Width="112" Height="34"
                                Click="Identify_Click" ToolTip="Identify mode: click a lamp on the map and it blinks so you can find it on the playfield (instead of latching it on)."/>
                    </Grid>

                    <!-- Backglass-style panel around the score lamps -->
                    <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="14" Padding="14,16" HorizontalAlignment="Center"
                            BorderThickness="1" BorderBrush="#3AE7A91D" Background="#14000000">
                        <Border.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="26" ShadowDepth="0" Opacity="0.16"/></Border.Effect>
                        <Viewbox HorizontalAlignment="Center" Stretch="Uniform" StretchDirection="DownOnly">
                            <StackPanel>
                                <StackPanel x:Name="LampHundredsHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
                                <StackPanel x:Name="LampTensHost" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <StackPanel x:Name="LampSpecialHost" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Viewbox>
                    </Border>

                    <!-- Displayed score (the value the lit reels represent) -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="DISPLAYED SCORE" Style="{StaticResource Caption}" FontSize="13" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LampValueText" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="60"
                                   Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Ring gauge, with the live signal scope in its own screen below -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Width="164" Height="164" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Ellipse Width="140" Height="140" Stroke="#1EFFFFFF" StrokeThickness="11"/>
                            <Path x:Name="RingArc" Stroke="{StaticResource TealBrush}" StrokeThickness="11"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Effect><DropShadowEffect Color="#16C8B0" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/></Path.Effect>
                            </Path>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RingText" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                           FontSize="42" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="LAMPS LIT" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" VerticalAlignment="Stretch" MinHeight="96" Margin="2,12,2,2" CornerRadius="10" ClipToBounds="True"
                                BorderBrush="#242FE08C" BorderThickness="1">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Stretch="None">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#070B09" Geometry="M0,0 H22 V22 H0 Z">
                                            <GeometryDrawing.Pen><Pen Brush="#162FE08C" Thickness="1"/></GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <Canvas x:Name="ScopeHost"/>
                        </Border>
                    </Grid>

                    <!-- Service (moved here from the output column to cut scrolling) -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock Text="SERVICE" Style="{StaticResource Caption}" Foreground="{StaticResource PurpleBrush}" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3">
                            <Button Content="VIEW LOG" Style="{StaticResource PillButton}" Margin="0,0,4,0" Click="ViewLog_Click"
                                    ToolTip="Show the machine log."/>
                            <Button Content="WIRING TEST" Style="{StaticResource PillButton}" Margin="4,0,4,0" Click="WiringTest_Click"
                                    ToolTip="Guided test — press each switch and confirm it's wired."/>
                            <Button x:Name="GremlinBtn" Content="GREMLIN: ON" Style="{StaticResource PillButton}" Margin="4,0,0,0"
                                    Click="Gremlin_Click" ToolTip="Show or hide the little mechanic gremlin that roams this screen."/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Output tests -->
            <Border Grid.Column="2" x:Name="PanelOutput" Style="{StaticResource Card}" Margin="7,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="OUTPUT TESTS" Style="{StaticResource Caption}" Foreground="{StaticResource PurpleBrush}"/>

                        <TextBlock Text="LAMP PATTERNS" Style="{StaticResource GroupCap}" Margin="0,10,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Content="CHASE"      Style="{StaticResource PillButton}" Margin="0,0,4,6" Click="Pattern_Click" Tag="chase"/>
                            <Button Content="INSIDE-OUT" Style="{StaticResource PillButton}" Margin="4,0,0,6" Click="Pattern_Click" Tag="inout"/>
                            <Button Content="SWEEP"      Style="{StaticResource PillButton}" Margin="0,0,4,6" Click="Pattern_Click" Tag="sweep"/>
                            <Button Content="CASCADE"    Style="{StaticResource PillButton}" Margin="4,0,0,6" Click="Pattern_Click" Tag="cascade"/>
                            <Button Content="RANDOM"     Style="{StaticResource PillButton}" Margin="0,0,4,6" Click="Pattern_Click" Tag="random"/>
                            <Button Content="ALL ON"     Style="{StaticResource PillButton}" Margin="4,0,0,6" Click="Pattern_Click" Tag="allon"/>
                        </UniformGrid>

                        <TextBlock Text="BULB TEST" Style="{StaticResource GroupCap}"/>
                        <Button x:Name="BulbTestBtn" Content="BULB TEST (all lamps)" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Click="Hw_Click" Tag="bulb"
                                ToolTip="Fire each backglass lamp in turn to spot a dead bulb (previews on the map; drives real lamps with the boards connected)."/>

                        <!-- These drive the FT232H outputs, so they're disabled until all four boards are connected. -->
                        <StackPanel x:Name="HwOnlyPanel">
                            <TextBlock Text="SOLENOIDS" Style="{StaticResource GroupCap}"/>
                            <UniformGrid Columns="2">
                                <Button Content="WINNER LOCK" Style="{StaticResource PillButton}" Margin="0,0,3,0" Click="Solenoid_Click" Tag="WinnerLock" ToolTip="Pulse the winner-lock solenoid — its LED lights while energized."/>
                                <Button Content="COIN LOCK"   Style="{StaticResource PillButton}" Margin="3,0,0,0" Click="Solenoid_Click" Tag="CoinLock"   ToolTip="Pulse the coin-lock solenoid — its LED lights while energized."/>
                            </UniformGrid>
                            <UniformGrid x:Name="SolenoidHost" Columns="2" Margin="0,8,0,0"/>

                            <TextBlock Text="LED STRIP" Style="{StaticResource GroupCap}"/>
                            <UniformGrid Columns="3">
                                <Button Content="RED" Style="{StaticResource PillButton}" Margin="0,0,3,6" Click="Led_Click" Tag="Red"    ToolTip="Light the whole strip red — click again to turn it off."/>
                                <Button Content="GRN" Style="{StaticResource PillButton}" Margin="3,0,3,6" Click="Led_Click" Tag="Green"  ToolTip="Light the whole strip green — click again to turn it off."/>
                                <Button Content="BLU" Style="{StaticResource PillButton}" Margin="3,0,0,6" Click="Led_Click" Tag="Blue"   ToolTip="Light the whole strip blue — click again to turn it off."/>
                                <Button Content="YEL" Style="{StaticResource PillButton}" Margin="0,0,3,0" Click="Led_Click" Tag="Yellow" ToolTip="Light the whole strip yellow — click again to turn it off."/>
                                <Button Content="PUR" Style="{StaticResource PillButton}" Margin="3,0,3,0" Click="Led_Click" Tag="Purple" ToolTip="Light the whole strip purple — click again to turn it off."/>
                                <Button Content="WHT" Style="{StaticResource PillButton}" Margin="3,0,0,0" Click="Led_Click" Tag="White"  ToolTip="Light the whole strip white — click again to turn it off."/>
                            </UniformGrid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" x:Name="LedPatternCombo" Style="{StaticResource DarkCombo}" SelectionChanged="LedPatternCombo_Changed"
                                          IsSynchronizedWithCurrentItem="False"
                                          ToolTip="Pick a WS2812b show pattern — the strip below mimics it."/>
                                <Button Grid.Column="1" Content="STOP" Style="{StaticResource PillButton}" Width="76" Margin="8,0,0,0" Click="LedStop_Click"
                                        ToolTip="Stop the LED pattern."/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LED BRIGHTNESS" FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="–" Style="{StaticResource PillButton}" Width="48" Click="LedBright_Click" Tag="down"/>
                                    <Button Content="+" Style="{StaticResource PillButton}" Width="48" Margin="6,0,0,0" Click="LedBright_Click" Tag="up"/>
                                </StackPanel>
                            </Grid>
                            <Border CornerRadius="8" Background="#20000000" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="8,7" Margin="0,8,0,0">
                                <WrapPanel x:Name="LedDotHost" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="SOUND" Style="{StaticResource GroupCap}"/>
                        <Button x:Name="SoundTestBtn" Content="SOUND TEST" Style="{StaticResource PillButton}" HorizontalAlignment="Stretch" Click="SoundPlay_Click"
                                ToolTip="Play a test clip and animate the level meter (needs the sound files installed at C:\SkillGame\Sounds)."/>

                        <TextBlock Text="AUDIO LEVEL" Style="{StaticResource GroupCap}"/>
                        <Border Height="56" CornerRadius="8" Background="#14202634" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="8,6">
                            <StackPanel x:Name="VuHost" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="3" CornerRadius="10" Margin="0,12,0,0" Padding="16,9" Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="DevText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="FT232H: G1 — · G2 — · G3 — · G4 —   (not connected)" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="PollText" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource GreenBrush}"
                           Text="0.0 scans/s" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Roaming mechanic bot; drawn over everything, never blocks clicks. -->
        <!-- Hit-testable so the gremlin can be grabbed; no Background, so only his body catches clicks and empty space passes through to the panels. -->
        <Canvas x:Name="BotLayer" Grid.RowSpan="4" ClipToBounds="False">
            <Canvas x:Name="Ladder" Opacity="0">
                <Rectangle Canvas.Left="0"  Canvas.Top="0" Width="4" Height="120" Fill="#55697F"/>
                <Rectangle Canvas.Left="22" Canvas.Top="0" Width="4" Height="120" Fill="#55697F"/>
                <Rectangle Canvas.Left="0" Canvas.Top="14"  Width="26" Height="4" Fill="#48586B"/>
                <Rectangle Canvas.Left="0" Canvas.Top="38"  Width="26" Height="4" Fill="#48586B"/>
                <Rectangle Canvas.Left="0" Canvas.Top="62"  Width="26" Height="4" Fill="#48586B"/>
                <Rectangle Canvas.Left="0" Canvas.Top="86"  Width="26" Height="4" Fill="#48586B"/>
                <Rectangle Canvas.Left="0" Canvas.Top="110" Width="26" Height="4" Fill="#48586B"/>
            </Canvas>
            <local:MechanicBot x:Name="Bot"/>
        </Canvas>

        <!-- Self-test report -->
        <Grid x:Name="SelfTestOverlay" Grid.RowSpan="4" Panel.ZIndex="200" Visibility="Collapsed">
            <Rectangle Fill="#B8000000" MouseLeftButtonDown="SelfTestClose"/>
            <Border Width="640" MaxHeight="740" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="14"
                    Background="#12141C" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,16,14,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SELF-TEST REPORT" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource GoldBrush}"/>
                            <TextBlock x:Name="SelfTestStamp" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="SAVE REPORT" Style="{StaticResource PillButton}" Height="36" Width="140" Margin="0,0,8,0" Click="SelfTestSave"/>
                            <Button Content="✕" Style="{StaticResource PillButton}" Width="42" Height="36" Click="SelfTestClose"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,20,18">
                        <StackPanel x:Name="ReportHost"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
