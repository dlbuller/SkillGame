<UserControl x:Class="SkillGameWpf.SchematicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <Grid Margin="30,26,30,24" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="_enter" Y="20"/></Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="_enter" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="SCHEMATIC" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="34" Foreground="{DynamicResource GoldBrush}">
                    <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="system wiring · scroll to zoom · drag to pan · click a section to fly there"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,-2,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="ZoomText" Text="100%" VerticalAlignment="Bottom" Margin="0,0,4,2"
                       FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource CyanBrush}"/>
        </Grid>

        <!-- Section chips + reference-doc quick buttons (wraps if the row gets long) -->
        <WrapPanel Grid.Row="1" x:Name="ChipHost" Orientation="Horizontal" Margin="0,0,0,4"/>

        <!-- Diagram viewport: grid background, pan/zoom canvas -->
        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True" BorderBrush="#242FE08C" BorderThickness="1"
                Cursor="SizeAll">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="#080A10" Geometry="M0,0 H26 V26 H0 Z">
                            <GeometryDrawing.Pen><Pen Brush="#141A2A" Thickness="1"/></GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
            <Canvas x:Name="Viewport" Background="Transparent"
                    MouseWheel="Viewport_Wheel" MouseLeftButtonDown="Viewport_Down" MouseLeftButtonUp="Viewport_Up" MouseMove="Viewport_Move" MouseLeave="Viewport_Leave">
                <Canvas x:Name="Diagram" Width="1720" Height="980">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="Pan"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </Canvas>
        </Border>

        <!-- Block detail: a big zoom/pan view of your schematic + the theory of operation -->
        <Grid x:Name="DetailOverlay" Grid.RowSpan="3" Visibility="Collapsed">
            <Rectangle Fill="#C4000000" MouseLeftButtonDown="DetailScrim_Click"/>
            <Border Margin="34" CornerRadius="14" Background="#0E1016" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,14,14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="DetailAccent" Grid.Column="0" Width="5" Height="26" CornerRadius="2" Background="#E7A91D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="DetailTitle" Grid.Column="1" Text="" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BoardSideBtn" Content="BACK ▸" Style="{StaticResource PillButton}" Width="92" Height="36" Margin="0,0,14,0" Click="BoardSide_Click" Visibility="Collapsed"
                                    ToolTip="Flip between the front (component side) and back (solder side) of the board."/>
                            <Button Content="－" Style="{StaticResource PillButton}" Width="42" Height="36" Margin="0,0,6,0" Click="DetailZoomOut"/>
                            <Button Content="FIT" Style="{StaticResource PillButton}" Width="60" Height="36" Margin="0,0,6,0" Click="DetailFit"/>
                            <Button Content="＋" Style="{StaticResource PillButton}" Width="42" Height="36" Margin="0,0,14,0" Click="DetailZoomIn"/>
                            <Button Content="✕" Style="{StaticResource PillButton}" Width="42" Height="36" Click="CloseDetail"/>
                        </StackPanel>
                    </Grid>

                    <!-- body: schematic viewport (left) + theory (right); theory fills the width when there's no schematic -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <Border x:Name="TheoryPanel" Grid.Column="1" Width="330" Background="#0A0C12" BorderBrush="#1EFFFFFF" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
                            <StackPanel>
                                <TextBlock Text="THEORY OF OPERATION" Style="{StaticResource Caption}" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DetailTheory" Text="" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                                <StackPanel x:Name="PinoutPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="PinoutTitle" Text="PINOUT" Style="{StaticResource Caption}" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="PinoutRows"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- big schematic viewport: scroll to zoom, drag to pan -->
                    <Border x:Name="ImgBox" Grid.Column="0" ClipToBounds="True">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Brush="#0B0D12" Geometry="M0,0 H26 V26 H0 Z">
                                        <GeometryDrawing.Pen><Pen Brush="#151A26" Thickness="1"/></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Grid>
                            <Canvas x:Name="DetailViewport" Background="Transparent" Cursor="SizeAll"
                                    MouseWheel="DImg_Wheel" MouseLeftButtonDown="DImg_Down" MouseLeftButtonUp="DImg_Up" MouseMove="DImg_Move">
                                <Image x:Name="ImgSchem" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="DZoom" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="DPan"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Canvas>
                            <StackPanel x:Name="ImgPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                                <TextBlock Text="🖼" FontSize="30" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ImgPlaceholderText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DetailZoomText" Text="" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,10"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource CyanBrush}"/>
                            <!-- Power: a stacked deck of the separate supply rails; click to rotate to the next -->
                            <Grid x:Name="PowerDeck" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="PowerDeck_Click" Cursor="Hand"/>
                            <TextBlock x:Name="PowerHint" Visibility="Collapsed" Text="click the card to flip through the supplies →"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                                       Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                        </Grid>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
