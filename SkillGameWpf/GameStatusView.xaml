<UserControl x:Class="SkillGameWpf.GameStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkillGameWpf"
             FontFamily="{StaticResource UiFont}">
    <Grid Margin="34,28,34,28" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="_enter" Y="20"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="_enter" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <!-- Pulse only the small status dot; cheap element-opacity animation. -->
                        <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:1.3"/>
                    </Storyboard>
                </BeginStoryboard>
                <BeginStoryboard>
                    <!-- INSERT COIN blinks while idle; the panel hides mid-game. -->
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="InsertCoinText" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.7"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Grid Grid.Row="0" Margin="2,0,2,24">
            <StackPanel>
                <TextBlock Text="SKILLGAME" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="42" Foreground="{DynamicResource GoldBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="LogoGlow" Color="#E7A91D" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="A Tribute to the Game of Skill" Foreground="{StaticResource MutedBrush}"
                           FontSize="14" Margin="2,-4,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ClockText" Text="--:--:--" FontFamily="{StaticResource DisplayFont}"
                           FontSize="30" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateText" Text="" Foreground="{StaticResource MutedBrush}"
                           FontSize="13" HorizontalAlignment="Right"/>
            </StackPanel>
            <!-- Show-light strip spanning the width between the title and the clock. -->
            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="260,0,220,0">
                <TextBlock x:Name="StripLabel" Text="" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" Foreground="{StaticResource TealBrush}" Margin="0,0,0,6" Visibility="Hidden"/>
                <Border CornerRadius="14" Background="#18000000" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="18,12">
                    <Viewbox Height="92" HorizontalAlignment="Center">
                        <Canvas x:Name="FrontLedHost"/>
                    </Viewbox>
                </Border>
            </StackPanel>
            <!-- Spark particles fly out of the sign when it "shorts out" (drawn unscaled, over everything in the header). -->
            <Canvas x:Name="SparkLayer" IsHitTestVisible="False"/>
        </Grid>

        <!-- ===== Main dashboard ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Hero: the Skill-Roll playfield in the centre, flanked by SCORE/robot (top) and LEVEL/INSERT COIN (bottom) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <Grid>
                    <!-- centre: portrait playfield (a stylised recreation of the real board) -->
                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="6,8,6,8" RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform>
                            <TranslateTransform x:Name="PlayfieldShake"/>
                        </Viewbox.RenderTransform>
                        <Canvas x:Name="PlayfieldCanvas" Width="440" Height="661"/>
                    </Viewbox>

                    <!-- top-left: SCORE -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0">
                        <TextBlock Text="SCORE" Style="{StaticResource Caption}" Foreground="{StaticResource GreenBrush}"/>
                        <TextBlock x:Name="ScoreText" Text="0" FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="80" Foreground="{StaticResource TextBrush}"
                                   Margin="0,2,0,0" RenderTransformOrigin="0,0.5">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="ScoreGlow" Color="#2FE08C" BlurRadius="30" ShadowDepth="0" Opacity="0.0"/>
                            </TextBlock.Effect>
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScoreScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="ScoreRoll" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>

                    <!-- top-right: robot -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                        <local:RobotFace x:Name="Robot" Width="120" Height="120" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RobotAlert" Text="BOARD DISCONNECTED" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12.5" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center"
                                   Margin="0,2,0,0" Visibility="Collapsed">
                            <TextBlock.Effect><DropShadowEffect Color="#E2493C" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- bench-mode toggle, bottom-right under the robot -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,12"
                                ToolTip="Bench mode: ignore live switch inputs so unwired/floating boards can't start phantom games on their own. Turn this OFF once the real switch harness is connected.">
                        <TextBlock Text="BENCH MODE" FontFamily="{StaticResource DisplayFont}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <CheckBox x:Name="BenchToggleGame" Style="{StaticResource ToggleSwitch}" Click="BenchToggle_Click" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- bottom-left: LEVEL -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10">
                        <TextBlock Text="LEVEL" Style="{StaticResource Caption}" Foreground="{StaticResource GreenBrush}"/>
                        <TextBlock x:Name="LevelText" Text="0" FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="Bold" FontSize="52" Foreground="{StaticResource TextBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Info column -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.55*"/>
                    <RowDefinition Height="0.8*"/>
                    <RowDefinition Height="0.8*"/>
                </Grid.RowDefinitions>

                <!-- HIGH SCORES (top 5) + chase bar -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#26201605" Offset="0"/>
                            <GradientStop Color="#0E0F15" Offset="0.65"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="&#9733;" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,7,0">
                                <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="HIGH SCORES" Style="{StaticResource Caption}" Foreground="{DynamicResource GoldBrush}" Margin="0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Background="{DynamicResource GoldBrush}">
                                <Border.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                                <TextBlock Text="1" FontFamily="{StaticResource UiFont}" FontWeight="Bold" FontSize="16" Foreground="#20160A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="HighScoreText" Text="---" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="60" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center">
                                <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Row="2" x:Name="LeaderHost" Margin="0,4,0,0"/>
                        <StackPanel Grid.Row="3" x:Name="ChasePanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Border Height="14" CornerRadius="7" Background="#22000000" BorderBrush="#1EFFFFFF" BorderThickness="1">
                                <Grid x:Name="ChaseBarGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ChaseFillCol" Width="0*"/>
                                        <ColumnDefinition x:Name="ChaseEmptyCol" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="7" Background="{StaticResource GreenBrush}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ChaseText" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                       Foreground="{StaticResource GreenBrush}" Margin="2,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel x:Name="LastSwitchBox" VerticalAlignment="Center">
                        <TextBlock Text="LAST SWITCH" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}"/>
                        <TextBlock x:Name="LastSwitchText" Text="None" FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold" FontSize="44" Foreground="{StaticResource TextBrush}" Margin="0,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- INSERT COIN button + last-game recap; sits over the LAST SWITCH card while idle, hides when a game starts. -->
                <Border x:Name="IdlePanel" Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#C8000000" CornerRadius="12" Padding="16,9" BorderBrush="#66E7A91D" BorderThickness="1.5"
                        Cursor="Hand" MouseLeftButtonUp="InsertCoin_Click" ToolTip="Drop a coin — click to start a demo game.">
                    <Border.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Coin slot: a metal faceplate with a slot mouth; a coin drops in when a game starts. -->
                            <Canvas x:Name="CoinSlot" Width="47" Height="67" Margin="0,0,13,0" VerticalAlignment="Center"
                                    RenderTransformOrigin="0,0.5">
                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.84" ScaleY="0.84"/></Canvas.RenderTransform>
                                <Border Canvas.Left="5" Canvas.Top="2" Width="46" Height="76" CornerRadius="8" BorderBrush="#2A2E36" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B4BCC6" Offset="0"/>
                                            <GradientStop Color="#828A96" Offset="0.5"/>
                                            <GradientStop Color="#5A626E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse Canvas.Left="10" Canvas.Top="7" Width="4" Height="4" Fill="#40454E"/>
                                <Ellipse Canvas.Left="42" Canvas.Top="7" Width="4" Height="4" Fill="#40454E"/>
                                <Ellipse Canvas.Left="10" Canvas.Top="69" Width="4" Height="4" Fill="#40454E"/>
                                <Ellipse Canvas.Left="42" Canvas.Top="69" Width="4" Height="4" Fill="#40454E"/>
                                <Border Canvas.Left="23" Canvas.Top="15" Width="10" Height="34" CornerRadius="5" Background="#0B0D11" BorderBrush="#2A2E36" BorderThickness="1"/>
                                <TextBlock Canvas.Left="15" Canvas.Top="53" Text="25¢" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="13" Foreground="#2A2E36"/>
                                <Ellipse x:Name="SlotCoin" Canvas.Left="19" Canvas.Top="-20" Width="18" Height="18" Opacity="0">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFECAE" Offset="0"/>
                                            <GradientStop Color="#E7A91D" Offset="0.6"/>
                                            <GradientStop Color="#B4801A" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>
                            <TextBlock x:Name="InsertCoinText" Text="&#9654;  INSERT COIN  &#9664;" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="23" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center">
                                <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="LastGameText" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                                   Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#16123030" Offset="0"/>
                            <GradientStop Color="#0E0F15" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource TealBrush}" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Effect><DropShadowEffect Color="#16C8B0" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="SESSION" Style="{StaticResource Caption}" Foreground="{StaticResource TealBrush}" Margin="0"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionText" Text="0 games · 0 hits" FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold" FontSize="34" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Status bar: game status (left) + machine-mode indicators (right) ===== -->
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Border Style="{StaticResource Card}" Padding="22,14" HorizontalAlignment="Stretch" Margin="0,0,326,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Game Not Started" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" Foreground="{StaticResource TextBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SOUND SET" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="26,0,0,0"/>
                        <TextBlock x:Name="SoundSetText" Text="8-BIT" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" x:Name="StatusIndHost" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="DemoEndingCombo" Style="{StaticResource DarkCombo}" Width="118" Height="42"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsSynchronizedWithCurrentItem="False"
                          ToolTip="How the demo game ends: WIN, LOSE, or TILT"/>
                <Button x:Name="DemoButton" Content="DEMO GAME" Style="{StaticResource GoldButton}"
                        Width="184" Height="58" Click="DemoButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Effect overlays (clicks pass through). -->
        <Canvas x:Name="SparkleCanvas" Grid.RowSpan="3" IsHitTestVisible="False"/>
        <Canvas x:Name="ConfettiCanvas" Grid.RowSpan="3" IsHitTestVisible="False"/>

        <!-- NEW HIGH SCORE banner — flashes briefly when a game beats the machine's best -->
        <Border x:Name="NewHighBanner" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                Background="#E61A1A22" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="2" CornerRadius="18"
                Padding="48,26" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="BannerScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="&#9733;  NEW HIGH SCORE!  &#9733;" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                           FontSize="46" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="NewHighSub" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                           Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
