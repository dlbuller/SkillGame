<UserControl x:Class="SkillGameWpf.AuditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkillGameWpf"
             FontFamily="{StaticResource UiFont}">
    <Grid Margin="34,28,34,28" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="_enter" Y="20"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="_enter" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="2,0,0,20">
            <TextBlock Text="SYSTEM AUDITS" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="34" Foreground="{DynamicResource GoldBrush}">
                <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="the machine's permanent books" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,-2,0,0"/>
        </StackPanel>

        <!-- Stat cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"
                    ToolTip="Total games ever played on this machine. This lifetime counter is permanent — it is never reset.">
                <StackPanel>
                    <TextBlock Text="GAMES PLAYED" Style="{StaticResource Caption}" Foreground="{StaticResource GreenBrush}"/>
                    <TextBlock x:Name="StatGames" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="56" Foreground="{StaticResource TextBrush}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="StatGamesSub" Text="0 this session" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0"
                    ToolTip="Total time balls have been in play across every game — the sum of each game's duration.">
                <StackPanel>
                    <TextBlock Text="TIME PLAYED" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock x:Name="StatTime" Text="0m" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="56" Foreground="{StaticResource TextBrush}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="StatTimeSub" Text="all-time on the bench" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,8,0"
                    ToolTip="How many games ended in a WIN — the player reached the winning switch (S25/S26, 80 points).">
                <StackPanel>
                    <TextBlock Text="WINNERS" Style="{StaticResource Caption}" Foreground="{DynamicResource GoldBrush}"/>
                    <TextBlock x:Name="StatWinners" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="56" Foreground="{DynamicResource AmberBrush}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="StatWinnersSub" Text="games won" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,8,0"
                    ToolTip="Every scoring-switch hit ever recorded, added together across all switches and all games.">
                <StackPanel>
                    <TextBlock Text="TOTAL HITS" Style="{StaticResource Caption}" Foreground="{StaticResource TealBrush}"/>
                    <TextBlock x:Name="StatHits" Text="0" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="56" Foreground="{StaticResource TextBrush}" Margin="0,-4,0,0"/>
                    <TextBlock x:Name="StatHitsSub" Text="0 this session" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="8,0,0,0"
                    ToolTip="Total time the machine has been powered on, all-time.">
                <StackPanel>
                    <TextBlock Text="POWER ON" Style="{StaticResource Caption}" Foreground="{StaticResource PurpleBrush}"/>
                    <TextBlock x:Name="StatPowerOn" Text="0h 0m" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                               FontSize="44" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="StatPowerOnSub" Text="hours : minutes on" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detail: switch activity + high scores -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Switch activity -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0"
                    ToolTip="Lifetime hit count for every scoring switch — a permanent switch-wear log (how much life each has left). A Reset keeps these; the small number is the resettable count since the last reset.">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SWITCH ACTIVITY · LIFETIME WEAR" Style="{StaticResource Caption}"
                               Foreground="{StaticResource GreenBrush}" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SwitchList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#14202634" CornerRadius="9" Margin="3" Padding="12,9"
                                            BorderBrush="#22FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="86">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="16" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Points}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <!-- bar -->
                                            <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#20FFFFFF"
                                                    VerticalAlignment="Center" Margin="6,0,10,0">
                                                <Border HorizontalAlignment="Left" CornerRadius="4"
                                                        Width="{Binding BarWidth}" Background="{StaticResource TealBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="58">
                                                <TextBlock Text="{Binding Hits}" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                                           Foreground="{StaticResource CyanBrush}" TextAlignment="Right"/>
                                                <TextBlock Text="{Binding SinceReset}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- High scores -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"
                    ToolTip="The top ten scores ever posted, highest first, with the date each was set.">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HIGH SCORES" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,10"/>
                    <!-- the accountant gremlin, hard at work on the books -->
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" CornerRadius="10" Background="#14202634" BorderBrush="#22FFFFFF" BorderThickness="1"
                            ToolTip="The house accountant, keeping the books.">
                        <StackPanel>
                            <TextBlock Text="CRUNCHIN THE NUMBERS" Style="{StaticResource Caption}" FontSize="12"
                                       Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
                            <Viewbox Height="140" Margin="0,0,0,6" StretchDirection="DownOnly">
                                <local:AccountantBot/>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="HighScoreList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20" Foreground="{StaticResource TextBrush}" Width="40"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Score}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="22" Foreground="{DynamicResource AmberBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding When}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackupBtn" Content="BACKUP AUDITS" Style="{StaticResource PillButton}" Width="180" Click="Backup_Click"
                        ToolTip="Save the audit file and write a datestamped copy beside it, so the books can be restored later."/>
                <Button x:Name="ExportBtn" Content="EXPORT CSV" Style="{StaticResource PillButton}" Width="150" Margin="12,0,0,0" Click="Export_Click"
                        ToolTip="Write all audit counters, switch hits, and high scores to a spreadsheet-ready .csv file."/>
                <Button x:Name="ClearScoresBtn" Content="CLEAR HIGH SCORES" Style="{StaticResource PillButton}" Width="210" Margin="12,0,0,0" Click="ClearScores_Click"
                        ToolTip="Wipe only the high-score table. Games played, hits and play time are kept."/>
            </StackPanel>
            <Button x:Name="ResetBtn" Content="RESET COUNTERS" HorizontalAlignment="Right" Width="180"
                    Style="{StaticResource PillButton}" Click="Reset_Click"
                    ToolTip="Zero the resettable counters and clear the high-score table. Total Games Played, power-on hours, and the lifetime switch-wear log are permanent and are kept."/>
        </Grid>
    </Grid>
</UserControl>
