<UserControl x:Class="SkillGameWpf.AccountantBot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The gremlin as an accountant: seated behind a desk, eyeshade + glasses, scribbling in a ledger and counting. -->
    <Canvas Width="230" Height="150" Background="#00000000" Cursor="Hand"
            MouseLeftButtonDown="Bot_Click" ToolTip="Click me">

        <!-- floating tally numbers rise from the desk -->
        <Canvas x:Name="NumberHost"/>

        <!-- ===== the gremlin behind the desk (lower half hidden by the desk) ===== -->
        <Canvas x:Name="Body">
            <!-- torso -->
            <Border Canvas.Left="88" Canvas.Top="52" Width="56" Height="56" CornerRadius="16" Background="#6DBE45" BorderBrush="#4E9331" BorderThickness="2"/>
            <!-- collar / shirt -->
            <Path Canvas.Left="98" Canvas.Top="58" Fill="#EDEFE8" Data="M 0,0 L 18,10 L 36,0 L 30,20 L 6,20 Z"/>
            <Path Canvas.Left="114" Canvas.Top="60" Fill="#2A3550" Data="M 0,0 L 4,0 L 3,18 L 2,22 L 1,18 Z"/>

            <!-- left arm resting on the desk -->
            <Rectangle Canvas.Left="80" Canvas.Top="74" Width="30" Height="10" RadiusX="5" RadiusY="5" Fill="#6DBE45" Stroke="#4E9331" StrokeThickness="1.5"
                       RenderTransformOrigin="0.9,0.5">
                <Rectangle.RenderTransform><RotateTransform Angle="16"/></Rectangle.RenderTransform>
            </Rectangle>

            <!-- ears -->
            <Polygon Points="90,34 78,20 92,28" Fill="#6DBE45" Stroke="#4E9331" StrokeThickness="1.5"/>
            <Polygon Points="140,34 152,20 138,28" Fill="#6DBE45" Stroke="#4E9331" StrokeThickness="1.5"/>

            <!-- head group (nods while working) -->
            <Canvas x:Name="Head" RenderTransformOrigin="0,0">
                <Canvas.RenderTransform><RotateTransform x:Name="HeadRot" CenterX="115" CenterY="52"/></Canvas.RenderTransform>
                <Border Canvas.Left="92" Canvas.Top="16" Width="46" Height="40" CornerRadius="16" Background="#6DBE45" BorderBrush="#4E9331" BorderThickness="2"/>
                <!-- hair tuft -->
                <Path Canvas.Left="110" Canvas.Top="10" Fill="#4E9331" Data="M 0,7 L 3,0 L 5,6 L 8,1 L 9,7 Z"/>

                <!-- eyes -->
                <Ellipse x:Name="EyeLWhite" Canvas.Left="99" Canvas.Top="28" Width="13" Height="14" Fill="#F1F5EC" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeLScale" ScaleY="1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="EyeRWhite" Canvas.Left="117" Canvas.Top="28" Width="13" Height="14" Fill="#F1F5EC" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="EyeRScale" ScaleY="1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="103" Canvas.Top="33" Width="5" Height="6" Fill="#1A2230"/>
                <Ellipse Canvas.Left="121" Canvas.Top="33" Width="5" Height="6" Fill="#1A2230"/>

                <!-- round accountant glasses -->
                <Ellipse Canvas.Left="98" Canvas.Top="27" Width="15" Height="16" Stroke="#20242C" StrokeThickness="1.8"/>
                <Ellipse Canvas.Left="116" Canvas.Top="27" Width="15" Height="16" Stroke="#20242C" StrokeThickness="1.8"/>
                <Line X1="113" Y1="34" X2="116" Y2="34" Stroke="#20242C" StrokeThickness="1.8"/>

                <!-- green eyeshade visor -->
                <Rectangle Canvas.Left="93" Canvas.Top="20" Width="44" Height="6" RadiusX="3" RadiusY="3" Fill="#2E6B1E"/>
                <Path Canvas.Left="92" Canvas.Top="24" Fill="#3C8A28" Data="M 0,0 Q 23,14 46,0 L 44,3 Q 23,15 2,3 Z"/>

                <!-- small focused mouth -->
                <Path Canvas.Left="0" Canvas.Top="0" Stroke="#2A1712" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 108,49 L 122,49"/>
            </Canvas>

            <!-- right arm + hand holding a pen; scribbles on the ledger -->
            <Canvas x:Name="PenArm" Canvas.Left="132" Canvas.Top="72" RenderTransformOrigin="0,0">
                <Canvas.RenderTransform><RotateTransform x:Name="PenRot" Angle="0"/></Canvas.RenderTransform>
                <Rectangle Canvas.Left="-2" Canvas.Top="-4" Width="26" Height="9" RadiusX="4" RadiusY="4" Fill="#6DBE45" Stroke="#4E9331" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="22" Canvas.Top="-4" Width="9" Height="9" Fill="#A6D98A"/>
                <!-- pen -->
                <Rectangle Canvas.Left="27" Canvas.Top="0" Width="3" Height="16" RadiusX="1" RadiusY="1" Fill="#2A3550" RenderTransformOrigin="0.5,0">
                    <Rectangle.RenderTransform><RotateTransform Angle="28"/></Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Canvas>

        <!-- ===== the desk (drawn over the gremlin's lower half) ===== -->
        <Canvas>
            <!-- ledger / paper on the desk -->
            <Border Canvas.Left="118" Canvas.Top="86" Width="70" Height="26" CornerRadius="2" Background="#F4F1E4" BorderBrush="#C9BE97" BorderThickness="1"/>
            <Path Canvas.Left="122" Canvas.Top="90" Stroke="#9DB0C8" StrokeThickness="1" Data="M0,0 H60 M0,5 H60 M0,10 H60 M0,15 H60"/>

            <!-- adding machine with a curling paper tape -->
            <Path Canvas.Left="36" Canvas.Top="70" Fill="#F4F1E4" Stroke="#C9BE97" StrokeThickness="1" Data="M 6,18 C 2,6 10,2 14,10 L 14,20 L 6,20 Z"/>
            <Border Canvas.Left="30" Canvas.Top="84" Width="40" Height="24" CornerRadius="4" Background="#2B303B" BorderBrush="#454C5A" BorderThickness="1"/>
            <Border Canvas.Left="34" Canvas.Top="87" Width="32" Height="9" CornerRadius="2" Background="#0C1610">
                <TextBlock x:Name="CalcDisplay" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="8" Foreground="#5CE08C"
                           TextAlignment="Right" Padding="0,0,3,0"/>
            </Border>
            <UniformGrid Canvas.Left="35" Canvas.Top="98" Width="30" Height="8" Columns="4" Rows="1">
                <Ellipse Width="4" Height="4" Margin="1" Fill="#556"/>
                <Ellipse Width="4" Height="4" Margin="1" Fill="#556"/>
                <Ellipse Width="4" Height="4" Margin="1" Fill="#556"/>
                <Ellipse Width="4" Height="4" Margin="1" Fill="#556"/>
            </UniformGrid>

            <!-- desk top lip + front -->
            <Rectangle Canvas.Left="0" Canvas.Top="108" Width="230" Height="8" Fill="#8A5A2B"/>
            <Rectangle Canvas.Left="0" Canvas.Top="116" Width="230" Height="34" Fill="#5A3C24"/>
            <Rectangle Canvas.Left="0" Canvas.Top="108" Width="230" Height="2" Fill="#A9743A"/>
            <!-- drawer knobs -->
            <Ellipse Canvas.Left="150" Canvas.Top="128" Width="7" Height="7" Fill="#C9A227"/>
            <Ellipse Canvas.Left="66" Canvas.Top="128" Width="7" Height="7" Fill="#C9A227"/>
            <Rectangle Canvas.Left="120" Canvas.Top="123" Width="60" Height="16" Stroke="#43301E" StrokeThickness="1" Fill="#00000000"/>
            <Rectangle Canvas.Left="40" Canvas.Top="123" Width="60" Height="16" Stroke="#43301E" StrokeThickness="1" Fill="#00000000"/>
        </Canvas>

        <!-- speech bubble (shown when he's clicked) — sits up and to the right so it doesn't cover his face -->
        <Canvas x:Name="Bubble" Visibility="Collapsed">
            <Path Canvas.Left="128" Canvas.Top="36" Fill="#F7F3E6" Stroke="#C9BE97" StrokeThickness="1.5" Data="M 10,0 L 24,0 L 6,15 Z"/>
            <Border Canvas.Left="132" Canvas.Top="0" Width="96" Height="40" CornerRadius="10" Background="#F7F3E6" BorderBrush="#C9BE97" BorderThickness="1.5">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="1.5" Opacity="0.35"/></Border.Effect>
                <TextBlock x:Name="BubbleText" Text="" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="#2A2A22" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="6,0"/>
            </Border>
        </Canvas>
    </Canvas>
</UserControl>
