<Application x:Class="SkillGameWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SkillGameWpf">
    <Application.Resources>
        <ResourceDictionary>

            <local:SoundSetIconConverter x:Key="SoundSetIcon"/>
            <local:SoundSetColorConverter x:Key="SoundSetColor"/>

            <!-- ===== Palette (dark arcade dashboard, mid-century Bally accents) ===== -->
            <Color x:Key="BgTop">#12121A</Color>
            <Color x:Key="BgBottom">#0A0A10</Color>
            <SolidColorBrush x:Key="CardBrush"        Color="#191922"/>
            <SolidColorBrush x:Key="CardBrush2"       Color="#20202C"/>
            <SolidColorBrush x:Key="CardBorderBrush"  Color="#31313F"/>
            <SolidColorBrush x:Key="GoldBrush"        Color="#E7A91D"/>
            <SolidColorBrush x:Key="GoldDimBrush"     Color="#7A5A12"/>
            <SolidColorBrush x:Key="TealBrush"        Color="#16C8B0"/>
            <SolidColorBrush x:Key="CyanBrush"        Color="#33C9FF"/>
            <SolidColorBrush x:Key="GreenBrush"       Color="#2FE08C"/>
            <SolidColorBrush x:Key="AmberBrush"       Color="#F0AA1E"/>
            <SolidColorBrush x:Key="PurpleBrush"      Color="#B45AE0"/>
            <SolidColorBrush x:Key="RedBrush"         Color="#E2493C"/>
            <SolidColorBrush x:Key="TextBrush"        Color="#ECECF2"/>
            <SolidColorBrush x:Key="MutedBrush"       Color="#8A8A98"/>

            <!-- Accent colors (the picker swaps these live) — used by the controls' fills and glows. -->
            <Color x:Key="AccentColor">#E7A91D</Color>
            <Color x:Key="AccentBright">#F0AA1E</Color>
            <Color x:Key="AccentDim">#7A5A12</Color>

            <LinearGradientBrush x:Key="AppBg" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
                <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
            </LinearGradientBrush>

            <FontFamily x:Key="DisplayFont">Seven Segment, Consolas, Segoe UI</FontFamily>
            <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>

            <!-- ===== Frosted-glass surfaces ===== -->
            <!-- Translucent so the app gradient shows through (depth); bright top rim = glass edge. -->
            <LinearGradientBrush x:Key="GlassFill" StartPoint="0.15,0" EndPoint="0.55,1">
                <GradientStop Color="#26FFFFFF" Offset="0"/>
                <GradientStop Color="#12222836" Offset="0.10"/>
                <GradientStop Color="#0F1A1F2B" Offset="0.55"/>
                <GradientStop Color="#1410131C" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0"/>
                <GradientStop Color="#1AFFFFFF" Offset="0.35"/>
                <GradientStop Color="#0FFFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== Card (glass) ===== -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassFill}"/>
                <Setter Property="BorderBrush" Value="{StaticResource GlassRim}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.5" Color="#000000"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Interactive lift: the glass edge brightens on hover (no heavier blur — keeps it fast). -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#5A16C8B0"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Reusable breathing-glow storyboard for logos/accents (target must be a named DropShadowEffect). -->
            <Storyboard x:Key="BreatheGlow" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="BlurRadius" From="16" To="34" Duration="0:0:2.2"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.7" Duration="0:0:2.2"/>
            </Storyboard>

            <!-- ===== Section caption (big + bold + bright accent colour = pops, no per-caption blur) ===== -->
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            </Style>

            <!-- Settings/Service row label + value (shared by both screens) -->
            <Style x:Key="SetLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="SetValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="MinWidth" Value="92"/>
            </Style>

            <!-- App-wide tooltip: a dark, rounded, gold-edged card instead of the old pale-yellow box. -->
            <Style TargetType="ToolTip">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="320"
                                       Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
                                       FontSize="12.5" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border CornerRadius="8" Background="#1C2029" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" Padding="11,8">
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Nav button (sidebar) ===== -->
            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Margin" Value="12,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" CornerRadius="10" Background="Transparent" Padding="16,0">
                                <Grid>
                                    <Border x:Name="bar" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource GoldBrush}" Opacity="0" Margin="-8,10"/>
                                    <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#1C1C28"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Pill / accent button ===== -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource CardBrush2}"/>
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A2A38"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#15151D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gold variant — with a periodic shimmer sweep across the face. -->
            <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Foreground" Value="#12100A"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10" BorderThickness="0" ClipToBounds="True"
                                    Background="{DynamicResource GoldBrush}">
                                <Grid>
                                    <Rectangle x:Name="sheen" Width="60" Height="180" HorizontalAlignment="Left" Opacity="0.35">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-24"/>
                                                <TranslateTransform x:Name="sheenT" X="-80"/>
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="sheenT" Storyboard.TargetProperty="X"
                                                             From="-80" To="360" Duration="0:0:1.1" BeginTime="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="sheenT" Storyboard.TargetProperty="X"
                                                             From="360" To="360" Duration="0:0:2.4" BeginTime="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Neon slider ===== -->
            <Style x:Key="NeonSlider" TargetType="Slider">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" Background="#20FFFFFF"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource GoldBrush}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Width="18" Height="18" Fill="#EAFBF8">
                                                        <Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect>
                                                    </Ellipse>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Toggle switch (styled CheckBox) ===== -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="track" Width="54" Height="28" CornerRadius="14"
                                    Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Ellipse x:Name="knob" Width="20" Height="20" Fill="#C7C7D2"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource GoldBrush}"/>
                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    <Setter TargetName="knob" Property="Fill" Value="White"/>
                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                                    <Setter TargetName="track" Property="Effect">
                                        <Setter.Value><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Danger (Exit) button ===== -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10" Background="{StaticResource CardBrush2}" BorderBrush="#66E2493C" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource RedBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Dark ComboBox ===== -->
            <Style x:Key="ComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="14,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2A38"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource GoldBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCombo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" CornerRadius="10" Background="{StaticResource CardBrush2}"
                                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                      Data="M0,0 L9,0 L4.5,6 Z" Fill="{StaticResource MutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A2A38"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="15,0,34,0"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
                                    <Border Background="#1C1C26" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.6" Color="#000000"/></Border.Effect>
                                        <ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
