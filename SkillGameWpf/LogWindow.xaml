<Window x:Class="SkillGameWpf.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine Log" Height="620" Width="960"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="{StaticResource UiFont}">
    <Border Style="{StaticResource Card}" CornerRadius="14" Margin="10">
        <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MACHINE LOG" Style="{StaticResource Caption}" Foreground="{DynamicResource GoldBrush}"/>
                    <TextBlock x:Name="PathText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="REFRESH" Style="{StaticResource PillButton}" Width="120" Click="Refresh_Click"/>
                    <Button Content="CLOSE" Style="{StaticResource DangerButton}" Width="110" Margin="10,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Border CornerRadius="10" Background="#16000000" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="4">
                <TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}"
                         FontSize="13" Foreground="#C9C9D4" Background="Transparent" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
