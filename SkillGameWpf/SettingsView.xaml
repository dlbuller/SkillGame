<UserControl x:Class="SkillGameWpf.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- SetLabel / SetValue styles now live app-wide in App.xaml (shared with the Service screen). -->

    <Grid Margin="34,28,34,28" Opacity="0">
        <Grid.RenderTransform><TranslateTransform x:Name="_enter" Y="20"/></Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="_enter" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.55">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="2,0,0,20">
            <TextBlock Text="SETTINGS" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                       FontSize="34" Foreground="{DynamicResource GoldBrush}">
                <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="operator setup · saved to the machine" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="2,-2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Operator setup ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OPERATOR SETUP" Style="{StaticResource Caption}"
                               Foreground="{StaticResource GreenBrush}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="tune how the game plays, then SAVE"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>

                    <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="SaveBtn" Content="SAVE SETTINGS" Style="{StaticResource GoldButton}"
                                Height="52" Click="Save_Click"
                                ToolTip="Write these settings to the machine (operator_settings.json) and apply them to the running game."/>
                        <Button Grid.Column="2" x:Name="ResetBtn" Content="RESET TO DEFAULTS" Style="{StaticResource PillButton}"
                                Height="52" Click="Reset_Click"
                                ToolTip="Restore every setting on this screen to its factory default."/>
                    </Grid>

                    <StackPanel>
                        <!-- Count-up speed -->
                        <Grid Margin="0,7"
                              ToolTip="How fast the score sweeps up to a hit's value. Lower = snappier count-up.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COUNT-UP SPEED" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="CountUp" Style="{StaticResource NeonSlider}" Minimum="10" Maximum="300"
                                    Margin="12,0" ValueChanged="CountUp_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="CountUpVal" Style="{StaticResource SetValue}" Text="60 ms"/>
                        </Grid>

                        <!-- Attract light -->
                        <Grid Margin="0,7"
                              ToolTip="When the game sits idle, the lamps play an attract light-show. This is how often it fires.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ATTRACT LIGHT" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="AttractLight" Style="{StaticResource NeonSlider}" Minimum="10" Maximum="600"
                                    Margin="12,0" ValueChanged="AttractLight_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="AttractLightVal" Style="{StaticResource SetValue}" Text="120 s"/>
                        </Grid>

                        <!-- Attract sound -->
                        <Grid Margin="0,7"
                              ToolTip="When idle, the game plays an attract sound to draw players. This is how often it fires.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ATTRACT SOUND" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="AttractSound" Style="{StaticResource NeonSlider}" Minimum="10" Maximum="600"
                                    Margin="12,0" ValueChanged="AttractSound_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="AttractSoundVal" Style="{StaticResource SetValue}" Text="120 s"/>
                        </Grid>

                        <Border Height="1" Background="#1EFFFFFF" Margin="0,12"/>

                        <!-- Bench mode -->
                        <Grid Margin="0,7"
                              ToolTip="Bench testing with nothing wired to the boards? Turn this ON so floating inputs can't start phantom games. Turn OFF once the switch harness is connected.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="BENCH MODE" Style="{StaticResource SetLabel}"/>
                                <TextBlock Text="ignore switch inputs" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="BenchToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="bench"/>
                        </Grid>

                        <!-- Tilt -->
                        <Grid Margin="0,7"
                              ToolTip="Honor the tilt switch. Turn off to ignore a finicky tilt that keeps ending games early.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TILT SWITCH" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="2" x:Name="TiltToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                        </Grid>

                        <Grid Margin="0,7"
                              ToolTip="Free tilt nudges before the game tilts (score void). 0 = the very first tilt ends the game; 1 gives one warning then tilts; higher gives more warnings first.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TILTS ALLOWED" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="TiltsSlider" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0" ValueChanged="TiltsAllowed_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="TiltsVal" Style="{StaticResource SetValue}" Text="0"/>
                        </Grid>

                        <!-- Quiet hours -->
                        <Grid Margin="0,7"
                              ToolTip="Cap the volume overnight so the machine does not blast attract audio after hours.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUIET HOURS" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="2" x:Name="QuietToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click"/>
                        </Grid>

                        <Grid Margin="0,7"
                              ToolTip="Quiet hours begin at this time (12-hour clock).">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUIET FROM" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="QuietStart" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="23"
                                    Margin="12,0" ValueChanged="QuietStart_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="QuietStartVal" Style="{StaticResource SetValue}" Text="10 PM"/>
                        </Grid>

                        <Grid Margin="0,7"
                              ToolTip="Quiet hours end at this time (12-hour clock).">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUIET UNTIL" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="QuietEnd" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="23"
                                    Margin="12,0" ValueChanged="QuietEnd_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="QuietEndVal" Style="{StaticResource SetValue}" Text="8 AM"/>
                        </Grid>

                        <Grid Margin="0,7"
                              ToolTip="While quiet hours are active, master volume is capped to this percentage.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUIET VOLUME" Style="{StaticResource SetLabel}"/>
                            <Slider Grid.Column="1" x:Name="QuietVol" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100"
                                    Margin="12,0" ValueChanged="QuietVol_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="QuietVolVal" Style="{StaticResource SetValue}" Text="20%"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Sound & Lighting ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SOUND · LIGHTING" Style="{StaticResource Caption}" Foreground="{StaticResource PurpleBrush}" VerticalAlignment="Center"/>
                        <Canvas Grid.Column="1" x:Name="GearHost" Width="66" Height="40" VerticalAlignment="Center"
                                ToolTip="The machine's sound &amp; light engine, humming along."/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="volume, sound set, attract &amp; distract" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,16"/>
                    <!-- gearworks machine at the bottom of the panel; pure eye-candy that says "the machine's running" -->
                    <Viewbox DockPanel.Dock="Bottom" Height="112" Margin="0,10,0,0" HorizontalAlignment="Center" StretchDirection="DownOnly"
                             ToolTip="Just for looks — the machine, running.">
                        <Canvas x:Name="GearMachineHost" Width="380" Height="108"/>
                    </Viewbox>
                    <StackPanel>
                        <Grid Margin="0,6" ToolTip="Master volume for the machine's audio.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VOLUME" Style="{StaticResource SetLabel}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="–" Style="{StaticResource PillButton}" Width="46" Click="VolDown_Click"/>
                                <Button x:Name="MuteBtn" Content="MUTE" Style="{StaticResource PillButton}" Width="82" Margin="6,0,0,0" Click="Mute_Click"/>
                                <Button Content="+" Style="{StaticResource PillButton}" Width="46" Margin="6,0,0,0" Click="VolUp_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="VolText" Style="{StaticResource SetValue}" Text="--" MinWidth="64"/>
                        </Grid>

                        <Grid Margin="0,10,0,6" ToolTip="Which set of scoring sounds to use (folders under C:\SkillGame\Sounds). TEST plays through the whole set — each sound plays in full; NEXT skips ahead.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SOUND SET" Style="{StaticResource SetLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" x:Name="SoundPkgCombo" Style="{StaticResource DarkCombo}" HorizontalAlignment="Stretch" SelectionChanged="SoundPkg_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center"
                                                    Background="{Binding Converter={StaticResource SoundSetColor}}">
                                                <ContentControl Content="{Binding Converter={StaticResource SoundSetIcon}}" FontFamily="Segoe UI Emoji" FontSize="15"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button x:Name="TestSetBtn" Content="TEST" Style="{StaticResource PillButton}" Width="80" Click="TestSet_Click"
                                        ToolTip="Play through every sound in this set — each one plays in full."/>
                                <Button x:Name="TestNextBtn" Content="NEXT ▸" Style="{StaticResource PillButton}" Width="74" Margin="6,0,0,0" Click="TestNext_Click"
                                        Visibility="Collapsed" ToolTip="Skip to the next sound without waiting for this one to finish."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TestNowText" Foreground="{StaticResource CyanBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                   Margin="0,0,0,2" Visibility="Collapsed"/>

                        <Border Height="1" Background="#1EFFFFFF" Margin="0,12"/>

                        <Grid Margin="0,6" ToolTip="Scoring sound effects during a game."><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SOUND FX" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="1" x:Name="SoundFxToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="soundfx"/>
                        </Grid>
                        <Grid Margin="0,6" ToolTip="Play attract sounds while the machine sits idle."><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ATTRACT SOUND" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="1" x:Name="AttractSoundToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="attractsound"/>
                        </Grid>
                        <Grid Margin="0,6" ToolTip="Play the attract light show while idle."><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ATTRACT LIGHTS" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="1" x:Name="AttractLightsToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="attractlights"/>
                        </Grid>
                        <Grid Margin="0,6" ToolTip="Once a game reaches the deeper levels — where gobble holes are live and a miss ends the game — the machine plays random, jarring SOUND between shots to break the player's concentration and make them blow the next roll. It works against the player on purpose; it is NOT a reward for scoring (a made shot already has its own win/score sounds). Turn off for a calmer, quieter game."><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DISTRACT SOUND" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="1" x:Name="DistractSoundToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="distractsound"/>
                        </Grid>
                        <Grid Margin="0,6" ToolTip="Same idea on the LED strip: once a game reaches the deeper levels (gobble holes live, a miss ends the game), the strip breaks into a wild, random LIGHT show between shots to pull the player's eye and make them miss the next roll. It's there to work against them, not to celebrate a hit (wins have their own separate light show). Turn off for a calmer board."><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DISTRACT LIGHTS" Style="{StaticResource SetLabel}"/>
                            <CheckBox Grid.Column="1" x:Name="DistractLightsToggle" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" Tag="distractlights"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Machine info ===== -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <DockPanel><!-- appearance docks top, machine info docks bottom, the medallion fills the middle -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="SKILLGAME" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="30" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="A Tribute to the Game of Skill" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <Border Height="1" Background="#1EFFFFFF" Margin="0,0,0,14"/>

                        <TextBlock Text="APPEARANCE" Style="{StaticResource Caption}" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,4"
                                   ToolTip="How the control panel looks: the highlight (accent) color used across the app, and overall screen brightness."/>
                        <TextBlock Text="the app's highlight color and screen dimming" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"
                                   ToolTip="How the control panel looks: the highlight (accent) color used across the app, and overall screen brightness."/>
                        <StackPanel ToolTip="Recolors the highlight theme used all over the app — the SKILLGAME titles, score digits, the flashing INSERT COIN sign, gold buttons, high-score numbers and their glows. Pick the color you want those to be.">
                            <TextBlock Text="ACCENT COLOR" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,7"
                                       ToolTip="Recolors the highlight theme used all over the app — titles, score digits, INSERT COIN, gold buttons, high-score numbers and their glows."/>
                            <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AccentName" Foreground="{DynamicResource GoldBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="13" Margin="0,0,0,14"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,6" ToolTip="Dim the whole screen for the cabinet.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BRIGHTNESS" Style="{StaticResource SetLabel}" FontSize="14"/>
                            <Slider Grid.Column="1" x:Name="Brightness" Style="{StaticResource NeonSlider}" Minimum="30" Maximum="100" Margin="10,0" ValueChanged="Brightness_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="BrightnessVal" Style="{StaticResource SetValue}" Text="100%" MinWidth="58"/>
                        </Grid>
                    </StackPanel>

                    <!-- Machine info pinned to the bottom of the column, away from Appearance -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="#1EFFFFFF" Margin="0,0,0,14"/>
                        <TextBlock Text="MACHINE INFO" Style="{StaticResource Caption}" Foreground="{StaticResource TealBrush}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="InfoStack"/>
                    </StackPanel>

                    <!-- Wheezing Bull maker medallion filling the gap between Appearance and Machine Info -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.95">
                        <Viewbox Width="150" Height="150" HorizontalAlignment="Center">
                            <Grid x:Name="MedalGrid" Width="156" Height="156">
                                <!-- reeded coin edge -->
                                <Ellipse Width="152" Height="152" Stroke="{DynamicResource GoldDimBrush}" StrokeThickness="2"/>
                                <Ellipse Width="140" Height="140" Stroke="{DynamicResource GoldBrush}" StrokeThickness="2.5" StrokeDashArray="0.5 2" StrokeDashCap="Round"/>
                                <Ellipse Width="120" Height="120" Stroke="#2EFFFFFF" StrokeThickness="1"/>
                                <!-- ring text (top + bottom) -->
                                <TextBlock Text="WHEEZING BULL" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource GoldBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"/>
                                <TextBlock Text="★ EST. 2026 ★" FontFamily="{StaticResource DisplayFont}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                                <!-- the bull, on a cream medal disc with a soft glow -->
                                <Ellipse Width="78" Height="78" Fill="#F2EFE6" Stroke="#C9A227" StrokeThickness="2">
                                    <Ellipse.Effect><DropShadowEffect Color="#E7A91D" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/></Ellipse.Effect>
                                </Ellipse>
                                <Image Source="file:///C:/SkillGame/wheezingbull.png" Width="66" Height="66" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="ALL HUFF · NO BULL" FontFamily="{StaticResource DisplayFont}" FontSize="13" Foreground="{DynamicResource GoldBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
